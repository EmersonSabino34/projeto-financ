# Supabase — Project Settings > API
# Copie para .env.local e preencha. Sem estas variáveis o app roda
# em modo local (localStorage), sem base de dados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres do Supabase — Project Settings > Database > Connection string
# Usadas pelo Prisma (servidor). Sem elas, o painel admin e o registo de
# acessos ficam desligados; o resto do app funciona na mesma.
#
#   DATABASE_URL: ligação com pool (porta 6543), para o app a correr
#   DIRECT_URL:   ligação direta (porta 5432), para `prisma db pull`
#
# Ponha-as no .env (o Prisma CLI só lê esse) — o Next também o carrega.
DATABASE_URL=
DIRECT_URL=

# Quem pode abrir /admin antes de haver algum profiles.is_admin marcado.
# Separar por vírgulas.
ADMIN_EMAILS=

# Opcional. Serviço que resolve o país/estado/cidade de um IP quando a
# rede não manda esses cabeçalhos. `{ip}` é substituído pelo endereço.
# Em branco usa https://ipapi.co/{ip}/json/
GEO_LOOKUP_URL=
